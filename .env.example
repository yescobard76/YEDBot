# YEDTradingBot — variables de entorno
#
# NUNCA subas este archivo con valores reales. Copia a .env (ignorado por git)
# y completa solo lo que necesites. El backend no incluye credenciales.
# Ningún adaptador de broker en vivo está implementado todavía: estas variables
# documentan lo que exigirá cada integración, no habilitan trading real.

# --- Tradovate -------------------------------------------------------------
TRADOVATE_API_URL=
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_ACCOUNT_ID=

# --- Interactive Brokers (TWS / IB Gateway) --------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=
# Requiere TWS o IB Gateway en ejecución y permisos de datos CME para NQ/MNQ/ES.

# --- Rithmic ---------------------------------------------------------------
RITHMIC_USER=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM=
RITHMIC_GATEWAY=
RITHMIC_ACCOUNT_ID=

# --- Datos históricos (Databento) ------------------------------------------
# Solo para server/market/databento_fetch.py. Sin clave se puede usar --fixture.
DATABENTO_API_KEY=

# --- Aplicación ------------------------------------------------------------
# Host/puerto del dashboard local.
YED_HOST=127.0.0.1
YED_PORT=8765
YED_OPEN=1

# Por defecto el motor rechaza feeds sintéticos. Actívalo solo para una demo
# explícita; nunca para operar o calibrar con datos inventados.
YED_ALLOW_SIMULATED=0

# --- Datos reales (Massive Futures Basic, plan gratuito) --------------------
# Crea la cuenta en https://massive.com/dashboard/signup y expórtala en la
# terminal (o cárgala con tu gestor de .env habitual). Nunca la subas al repo.
MASSIVE_API_KEY=
