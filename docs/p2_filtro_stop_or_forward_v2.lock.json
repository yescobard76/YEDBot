  "analysis": {
    "primary": {
      "id": "E1",
      "name": "selection_delta_r_accepted_vs_rejected",
      "formula": "mean(r_multiple | ratio >= 0.25) - mean(r_multiple | ratio < 0.25)",
      "unit": "trade",
      "cluster": "session",
      "effect_min_r": 0.25,
      "accepted_mean_min_r": 0.2
    },
    "portfolio_endpoint": {
      "id": "P1",
      "formula": "sum(r_multiple | ratio < 0.25) <= 0",
      "equivalent_to": "sum(r_multiple | ratio >= 0.25) >= sum(r_multiple | all baseline)"
    },
    "bootstrap": {
      "method": "session_cluster_percentile",
      "resamples": 10000,
      "seed": 20261124,
      "confidence": 0.95,
      "min_valid_resamples": 9500,
      "p_value": "one_sided_h0_delta_le_zero"
    },
    "gates": {
      "integrity": {
        "I1": "protocol, lock, P2 profile and code provenance hashes match",
        "I2": "all sessions inside 2026-12-01..2029-11-30; zero W1-W6, H1, 2024 or burn-in",
        "I3": "dataset valid: 39 contracts, 36 rolls, 12 roll sessions excluded, 3 aligned symbols, ORB complete, zero unjustified gaps",
        "I4": "prospective capture: per-session manifest, same-day captured_at_et, no backfill, no synthetic data, per-file SHA-256",
        "I5": "arms symmetric: same dataset, timestamps and settings except risk.min_stop_or_ratio",
        "I6": "ratio valid for 100% of baseline trades; A union Rj = B and A intersect Rj = empty",
        "I7": "no lookahead in ORB/stop ratio",
        "I8": "deterministic replay of 10% of sessions twice",
        "I9": "one-shot analysis output absent before start",
        "I10": "holdout_bars_read=false and zero H1 sessions"
      },
      "sample": {
        "S1": ">=720/742 evaluated sessions; no month <80%; no gap >5 consecutive",
        "S2": ">=60 baseline trades",
        "S3": ">=24 accepted and >=30 rejected",
        "S4": ">=5/6 blocks with baseline >=6 and accepted >=2",
        "S5": ">=5 accepted shorts; otherwise INCONCLUSO_SHORT"
      },
      "efficacy": {
        "E1": "delta_sel >= +0.25 R",
        "E2": "session-cluster bootstrap 95% lower bound > 0; INCONCLUSO if it includes 0; FAIL if upper bound <0",
        "E3": "mean_r_accepted >= +0.20 R"
      },
      "portfolio": {
        "P1": "sum_r_rejected <= 0",
        "P2": "r_profit_factor_accepted >= 1.25",
        "P3": "max_drawdown_r_accepted <= min(8 R, baseline R drawdown) and treatment USD drawdown <= min(2000, baseline USD drawdown)",
        "P4": "sum_r_rejected <= 0 in >=5/6 blocks",
        "P5": "drop_best_3_total_r > 0, drop_best_month_total_r > 0, top_trade_share_gross_r <= 50%",
        "P6": "exact stress: mean_r_accepted > 0 and r_profit_factor_accepted >= 1.10 with commission 1.24/side and slippage 2 ticks",
        "P7": "accepted trades in >=12/36 months; max consecutive zero months <=4",
        "P8": "if >=5 accepted shorts: short mean R >=0 and short total R >=0; else INCONCLUSO_SHORT",
        "P9": "treatment total R >= baseline total R and treatment USD drawdown <= baseline USD drawdown"
      },
      "robustness": {
        "R1": "top-2 blocks <=80% of treatment net",
        "R2": "block R profit factor >=0.70 in >=5/6 blocks with >=3 accepted trades"
      }
    },
    "decision": {
      "pass": "all I, S, E, P and R gates pass",
      "fail": "I and S pass and at least one E/P/R gate fails with clear negative evidence",
      "inconclusive": "I or S fails; or E2 includes zero without clear negative evidence and the rest do not fail; or fewer than 5 accepted shorts",
      "no_promotion_on_fail_or_inconclusive": true,
      "pass_does_not_authorize_live": true
    },
