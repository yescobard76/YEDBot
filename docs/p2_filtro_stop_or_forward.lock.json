  "analysis": {
    "primary": {
      "id": "E1",
      "name": "selection_delta_r_accepted_vs_rejected",
      "formula": "mean(r_multiple | ratio >= 0.25) - mean(r_multiple | ratio < 0.25)",
      "unit": "trade",
      "cluster": "session",
      "effect_min_r": 0.25,
      "accepted_mean_min_r": 0.2
    },
    "bootstrap": {
      "method": "session_cluster_percentile",
      "resamples": 10000,
      "seed": 20261123,
      "confidence": 0.95,
      "min_valid_resamples": 9500,
      "p_value": "one_sided_h0_delta_le_zero"
    },
    "gates": {
      "integrity": ["I1_protocol_lock_profile_hashes", "I2_all_sessions_inside_allowed_window", "I3_dataset_39_contracts_36_rolls_12_roll_sessions", "I4_prospective_capture_manifest_no_backfill", "I5_arms_differ_only_in_min_stop_or_ratio", "I6_ratio_valid_for_100pct_baseline_trades", "I7_no_lookahead_in_ratio", "I8_deterministic_replay_10pct_sessions", "I9_one_shot_analysis_output_absent"],
      "sample": {
        "S1": ">=720/742 evaluated sessions; no month <80%; no gap >5 consecutive",
        "S2": ">=60 baseline trades",
        "S3": ">=24 accepted and >=30 rejected",
        "S4": ">=5/6 blocks with baseline >=6 and accepted >=2",
        "S5": ">=5 accepted shorts; otherwise inconclusive_short"
      },
      "efficacy": {
        "E1": "delta_sel >= +0.25 R",
        "E2": "session-cluster bootstrap 95% lower bound > 0",
        "E3": "mean_r_accepted >= +0.20 R"
      },
      "portfolio": {
        "P1": "sum_r_rejected <= 0",
        "P2": "r_profit_factor_accepted >= 1.25",
        "P3": "max_drawdown_r_accepted <= min(8 R, baseline R drawdown) and treatment USD drawdown <= min(2000, baseline USD drawdown)",
        "P4": "sum_r_rejected <= 0 in >=5/6 blocks",
        "P5": "drop_best_3_total_r > 0, drop_best_month_total_r > 0, top_trade_share_gross_r <= 50%",
        "P6": "cost stress: mean_r_accepted > 0 and r_profit_factor_accepted >= 1.10",
        "P7": "accepted trades in >=12/36 months; max consecutive zero months <=4",
        "P8": "if >=5 accepted shorts: short mean R >=0 and short total R >=0; else inconclusive_short",
        "P9": "treatment total R >= baseline total R and treatment USD drawdown <= baseline USD drawdown"
      }
    },
    "decision": {
      "pass": "all I, S, E and P gates pass",
      "fail": "I and S pass and at least one E/P gate fails with clear negative evidence",
      "inconclusive": "I or S fails; or E2 includes zero without clear negative evidence and other gates do not fail; or fewer than 5 accepted shorts",
      "no_promotion_on_fail_or_inconclusive": true,
      "pass_does_not_authorize_live": true
    },
    "no_interim_efficacy_look": true,
    "no_parameter_search": true,
    "no_placebo_timing": true,
    "no_multiple_comparisons_correction": true
  },
